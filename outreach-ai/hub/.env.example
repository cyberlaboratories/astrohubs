# Copy to .env (mode 0600, owner root) and fill in. Never commit .env.
# GitHub OAuth app "Astrohub outreach-ai", callback https://astrohub.uvic.ca/outreach-ai/hub/oauth_callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub names of the hub's admins, comma separated
OUTREACH_AI_ADMINS=
# The single-user image
OUTREACH_AI_IMAGE=local/outreach:ai-2026-11-13
# The model keys are NOT here: they live only in gateway.env, for the gateway container (see gateway.env.example).
